<view class="page"><view class="title">AI 选课助手</view><view class="muted">例如：零基础，想学毛笔字，只能上午去，不想花钱。</view><textarea class="card" placeholder="说说兴趣、时间和费用条件" value="{{text}}" bindinput="input" maxlength="600"/><button class="btn" bindtap="search" loading="{{busy}}" disabled="{{busy}}">帮我选课</button><view class="muted">{{mode}} · {{notice}}</view><view class="card" wx:if="{{summary}}"><view>{{summary}}</view><view wx:for="{{labels}}" wx:key="*this">{{item}}</view><view wx:if="{{question}}">再问你一句：{{question}}</view></view><view wx:for="{{results}}" wx:key="id" class="card"><view class="big">{{item.title}}</view><view>规则得分：{{item.score}}</view><view>{{item.reason}}</view><view>{{item.location}}</view><button class="btn" data-id="{{item.id}}" bindtap="enroll">预约</button></view></view>
