<view class="page"><view class="title">智能找课</view><view class="muted">例如：周末想学安静的传统文化</view><input class="card" placeholder="说说你想学什么" value="{{text}}" bindinput="input"/><button class="btn" bindtap="search">开始推荐</button><view wx:for="{{results}}" wx:key="id" class="card"><view class="big">{{item.title}}</view><view>{{item.reason}}</view><button class="btn" data-id="{{item.id}}" bindtap="enroll">预约</button></view></view>
