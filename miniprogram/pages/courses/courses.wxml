<view class="page"><view class="title">课程列表</view><view wx:for="{{courses}}" wx:key="id" class="card"><view class="big">{{item.title}}</view><view><text class="tag">{{item.category}}</text><text class="tag">{{item.level}}</text></view><view class="meta">{{item.teacher}} · {{item.location}}</view><view class="meta">剩余 {{item.remaining}} 个名额</view><button class="btn" data-id="{{item.id}}" bindtap="detail">查看详情</button><button class="btn" data-id="{{item.id}}" bindtap="enroll">预约课程</button></view></view>
