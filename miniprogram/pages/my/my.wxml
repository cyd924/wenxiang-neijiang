<view class="page"><view class="title">我的课程</view><view wx:for="{{courses}}" wx:key="enrollment_id" class="card"><view class="big">{{item.title}}</view><view class="meta">{{item.teacher}} · {{item.location}}</view><view class="meta">报名状态：已报名</view><button class="btn secondary" data-id="{{item.enrollment_id}}" bindtap="cancel">取消报名</button></view><view wx:if="{{!courses.length}}" class="muted">还没有报名课程。</view></view>
